diff --git a/engine/common/soundlib/snd_utils.c b/engine/common/soundlib/snd_utils.c
index 19a74e2b..ec776053 100644
--- a/engine/common/soundlib/snd_utils.c
+++ b/engine/common/soundlib/snd_utils.c
@@ -102,6 +102,36 @@ uint GAME_EXPORT Sound_GetApproxWavePlayLen( const char *filepath )
 	// magic number from GoldSrc, seems to be header size
 	size_t filesize = FS_FileLength( f ) - 128;
 
+	// Compact Station sounds retain their original sample count in the standard
+	// WAV fact chunk. Compressed byte size cannot describe dialogue duration.
+	if( wav.riff_id == LittleLong( RIFFHEADER ) && wav.wave_id == LittleLong( WAVEHEADER )
+		&& LittleShort( wav.wFormatTag ) == 85 && LittleLong( wav.nSamplesPerSec ) > 0 )
+	{
+		const fs_offset_t length = FS_FileLength( f );
+		fs_offset_t position = 12;
+		while( position <= length - 8 )
+		{
+			chunkhdr_t chunk;
+			FS_Seek( f, position, SEEK_SET );
+			if( FS_Read( f, &chunk, sizeof( chunk )) != sizeof( chunk ))
+				break;
+			const uint32_t size = (uint32_t)LittleLong( chunk.dLen );
+			if( size > length - position - 8 )
+				break;
+			if( !memcmp( &chunk.data_id, "fact", 4 ) && size >= 4 )
+			{
+				uint32_t frames;
+				if( FS_Read( f, &frames, sizeof( frames )) == sizeof( frames ))
+				{
+					const uint msecs = (uint)((uint64_t)(uint32_t)LittleLong( frames ) * 1000 / LittleLong( wav.nSamplesPerSec ));
+					FS_Close( f );
+					return msecs;
+				}
+			}
+			position += 8 + (fs_offset_t)size + (size & 1);
+		}
+	}
+
 	FS_Close( f );
 
 	// is real wav file ?
